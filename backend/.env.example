# Required in production (Appwrite)
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-24chars-min
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=testspace
APPWRITE_BUCKET_ID=question_images
TELEGRAM_BOT_TOKEN=

# Recommended
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TELEGRAM_WEBHOOK_SECRET=
# Prefer webhooks when hosted as Appwrite Function; set true only for local long-polling
TELEGRAM_POLLING_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional teacher seed (legacy username/password — prefer Appwrite Auth email signup)
TEACHER_USERNAME=
TEACHER_PASSWORD=
TEACHER_NAME=
ENABLE_RESEED=false

# Private channel/chat ID where the bot stores question diagram photos (bot must be admin)
TELEGRAM_MEDIA_STORAGE_CHAT_ID=
